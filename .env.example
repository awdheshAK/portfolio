# Environment variables consumed by docker-compose.yml itself (host-level).
# Backend and frontend each have their OWN .env files — see backend/.env.example
# and frontend/.env.example. This file only covers values docker-compose reads
# directly when composing the Postgres/Redis containers and building images.

# --- Postgres (used by docker-compose to create the database container) ---
DB_DATABASE=clothing_platform
DB_USERNAME=postgres
DB_PASSWORD=change_me_before_running

# --- Frontend build-time public vars (baked into the Next.js build) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
