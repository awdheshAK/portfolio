# ---------------------------------------------------------------------------
# StreamVault environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL via Prisma)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace USERNAME/PASSWORD with your own local PostgreSQL credentials.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/videoapp?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# App secrets
# Used to sign download/streaming URLs (HMAC-SHA256). Generate with: openssl rand -hex 32
SIGNED_URL_SECRET="replace-with-a-long-random-string"
# Used to sign password-reset / email-verification tokens.
AUTH_TOKEN_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Storage configuration
# STORAGE_DRIVER: "local" (default) | "s3"
# The application talks to storage only through src/lib/storage, so switching
# this value (and adding S3 credentials) is the only change required to move
# to cloud object storage - no application code changes needed.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./storage"
# Public base path used to build (signed) URLs served by /api/files
PUBLIC_ASSET_BASE_URL="http://localhost:3000"

# Future cloud storage (S3-compatible). Only used when STORAGE_DRIVER=s3.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Optional CDN domain fronting the bucket
CDN_BASE_URL=""

# ---------------------------------------------------------------------------
# Video processing
# ---------------------------------------------------------------------------
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
MAX_UPLOAD_SIZE_BYTES="5368709120"
UPLOAD_CHUNK_SIZE_BYTES="8388608"
PROCESSING_WORKER_POLL_MS="3000"
PROCESSING_CONCURRENCY="2"

# ---------------------------------------------------------------------------
# Content safety (optional)
# Leave CLAMAV_HOST empty to skip malware scanning in local dev (format/magic
# byte validation and duplicate detection still run either way). Point these
# at a running ClamAV clamd daemon to enable real virus scanning on uploads.
# ---------------------------------------------------------------------------
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# ---------------------------------------------------------------------------
# AI features
# Leave ANTHROPIC_API_KEY empty to use the local heuristic AI provider
# (fully functional, no external calls) - see src/lib/ai.ts
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_PROVIDER="local"

# ---------------------------------------------------------------------------
# Email (password reset, notifications)
# Leave SMTP_HOST empty to use the console/dev provider which logs emails
# to the server console instead of sending them.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="StreamVault <noreply@streamvault.local>"

# ---------------------------------------------------------------------------
# Security / rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
DOWNLOAD_RATE_LIMIT_MAX="20"
SIGNED_URL_TTL_SECONDS="900"

# ---------------------------------------------------------------------------
# Seed script (npm run prisma:seed) - only used when seeding the database.
# These set the login for the two accounts the seed script creates. Change
# them (or leave unset to use the script's built-in example values) before
# sharing a database dump or deploying anywhere beyond your own machine.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@streamvault.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_EMAIL="creator@streamvault.local"
SEED_DEMO_PASSWORD="ChangeMe123!"

NODE_ENV="development"
