# --- Custom Clothing Platform (backend/ + frontend/) ---

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitkeep
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
!backend/storage/framework/*/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*.php
backend/public/hot
backend/public/storage
backend/.phpunit.result.cache
backend/Homestead.json
backend/Homestead.yaml
backend/auth.json

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/coverage/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
