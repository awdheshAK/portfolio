# Base URL of the Laravel backend API (see ../docs/API_CONTRACT.md).
# All requests are made to `${NEXT_PUBLIC_API_URL}/api/v1/...`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL this frontend is deployed at. Used for metadata (canonical
# URLs, Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay *publishable* Key ID (safe to expose client-side) used only to
# open the Razorpay Checkout widget in /checkout. The backend returns the
# authoritative razorpay_key_id per-order too; this is a fallback. NEVER put
# a Razorpay *secret* key here — the frontend never needs it.
NEXT_PUBLIC_RAZORPAY_KEY=

# Cloudinary cloud name, for reference/display only. The frontend never
# uploads to Cloudinary directly or holds any Cloudinary secret — uploads go
# through POST /api/v1/uploads/design-asset, which the backend signs and
# proxies to Cloudinary server-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
